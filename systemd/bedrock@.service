[Unit]
Description={descriptionPrefix} %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={serverUser}
Group={serverGroup}
WorkingDirectory={insDir}/current_%i
Environment=LD_LIBRARY_PATH=.
ExecStart={insDir}/current_%i/bedrock_server
Restart=on-failure
RestartSec={restartSec}
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:{insDir}/logs/bedrock_%i.log
StandardError=append:{insDir}/logs/bedrock_%i.log

[Install]
WantedBy=multi-user.target
